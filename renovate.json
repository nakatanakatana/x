{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>nakatanakatana/renovate-config#0.0.3"
  ],
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "pinDigests": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ],
    "ignorePaths": [
      "**/flux-system/**",
      "tests/testdata/kubeblocks/component-definitions.yaml",
      "tests/testdata/policies/invalid-latest.yaml"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)kustomization\\.ya?ml$/"
    ],
    "pinDigests": false
  },
  "flux": {
    "managerFilePatterns": [
      "/(?:^|/)gotk-components\\.ya?ml$/",
      "/(?:^|/)repository\\.ya?ml$/",
      "/(?:^|/)release\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)components/.*/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>pl4nty/cloudflare-kubernetes-gateway)//config/default\\?ref=(?<currentValue>v?[^\\s\"']+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)components/.*/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v?[^/]+)/[^\\s\"']+"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "**.image[repository and tag].{\"depName\": ($exists(registry) ? registry & \"/\" : \"\") & repository, \"currentValue\": tag, \"currentDigest\": digest}"
      ]
    }
  ]
}
