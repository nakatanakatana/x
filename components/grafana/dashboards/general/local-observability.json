{
  "uid": "local-observability",
  "title": "Local Observability",
  "tags": ["local", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-48h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Recent local logs",
      "type": "logs",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "local-loki"},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "local-loki"}, "expr": "{job=\"observability-local-alloy\"}", "queryType": "range", "maxLines": 100}]
    },
    {
      "id": 2,
      "title": "Local Mimir trial metric",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "local-mimir"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "local-mimir"}, "expr": "task4_mimir_trial_metric_total", "range": true}]
    },
    {
      "id": 3,
      "title": "Recent local traces",
      "type": "table",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "tempo", "uid": "local-tempo"},
      "targets": [{"refId": "A", "datasource": {"type": "tempo", "uid": "local-tempo"}, "queryType": "traceql", "query": "{}", "limit": 20}]
    }
  ]
}
